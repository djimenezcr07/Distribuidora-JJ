@using Microsoft.AspNetCore.Http
@using Proyecto_Final.Services
@inject AdminDbService AdminDbService
@inject IRolePermissionService PermissionService
@{
    var SiteBrandName = Company.Value.BrandName;
    var SiteBrandSubtitle = Company.Value.BrandSubtitle;
    var pageTitle = ViewData["Title"]?.ToString();
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? SiteBrandName
        : $"{pageTitle} - {SiteBrandName}";
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <title>@documentTitle</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Distribuidora JJ, licorera, distribuidora, licores, whisky, vinos, cervezas, ron, vodka" name="keywords">
    <meta content="@SiteBrandName - @SiteBrandSubtitle" name="description">

    <link href="@Url.Content("~/brand/stage2/icon_stage2-identity_favicon_20260821_32.svg")" rel="icon" type="image/svg+xml">
    <link href="@Url.Content("~/brand/stage2/icon_stage2-identity_favicon_20260821_32.png")" rel="icon" type="image/png" sizes="32x32">
    <link href="@Url.Content("~/brand/apple-touch-icon.png")?v=djj-1" rel="apple-touch-icon" sizes="180x180">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/custom-theme.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/ui-modern-2027.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/sprint3-ui-polish.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/sprint3-modal.css" rel="stylesheet" asp-append-version="true">
    <link rel="stylesheet" href="~/css/sprint4-frontend-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/brand-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sprint4-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>

<body data-authenticated-user-id="@(Context.Session.GetInt32("UserId")?.ToString() ?? string.Empty)">
    @{
        var userName = Context.Session.GetString("UserFullName");
        var userRole = Context.Session.GetString("UserRole");
        var isLoggedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("UserEmail"));
        var isAdmin = isLoggedIn && string.Equals(userRole, "Administrador", StringComparison.OrdinalIgnoreCase);
        var isClient = isLoggedIn && string.Equals(userRole, "Cliente", StringComparison.OrdinalIgnoreCase);
        var isChofer = isLoggedIn && string.Equals(userRole, "Chofer", StringComparison.OrdinalIgnoreCase);
        var userId = Context.Session.GetInt32("UserId") ?? 0;
        var effectivePermissions = isLoggedIn && !isAdmin
            ? await PermissionService.GetPermissionCodesAsync(userRole)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        bool HasPermission(string code) => isAdmin || effectivePermissions.Contains(code);
        var isEmployeePortalUser = isLoggedIn && await AdminDbService.IsEmployeeUserAsync(userId);
        var canViewBudgets = HasPermission("PRESUPUESTOS_VER");
        var canViewExpenses = HasPermission("GASTOS_VER");
        var canCompareBudgets = HasPermission("PRESUPUESTOS_COMPARAR");
        var canViewDeliveryBoard = HasPermission("ENTREGAS_TABLERO_VER");
        var canViewDocumentAlerts = HasPermission("DOCUMENTOS_VER");
        var canViewSuppliers = HasPermission("PROVEEDORES_VER");
        var canViewPurchaseOrders = HasPermission("COMPRAS_ORDENES_VER");
        var canViewPriceHistory = HasPermission("COMPRAS_PRECIOS_VER");
        var canViewEmployees = HasPermission("EMPLEADOS_VER");
        var canManageLeaveRequests = HasPermission("EMPLEADOS_SOLICITUDES");
        var canApproveAttendance = HasPermission("RRHH_JORNADAS_APROBAR");
        var canViewPayroll = HasPermission("PLANILLA_VER");
        var canManagePaySlips = HasPermission("PLANILLA_BOLETAS_GESTIONAR");
        var canCreateMobileSale = HasPermission("VENTA_MOVIL_CREAR");
        var canAuthorizeOrders = HasPermission("PEDIDOS_AUTORIZAR_RECHAZAR");
        var canViewManagementDashboard = HasPermission("REPORTES_DASHBOARD");
        var canViewSalesReports = HasPermission("REPORTES_VENTAS_VER");
        var canViewSellerReports = HasPermission("REPORTES_VENDEDORES_VER");
        var canViewKpis = HasPermission("REPORTE_KPI");
        var canUseFinance = HasPermission("LIQUIDACION_FINANCIERA");
        var canUseChat = HasPermission("CHAT_USAR");
        var canManageChat = HasPermission("CHAT_DEPARTAMENTOS_GESTIONAR");
        var categoriasLayout = await AdminDbService.GetStoreCategoriesAsync();
    }

    <div class="container-fluid topbar">
        <div class="row align-items-center py-2 px-xl-5">
            <div class="col-lg-6 d-none d-lg-block">
                <div class="d-inline-flex align-items-center flex-wrap">
                    <small class="text-light"><i class="fa fa-map-marker-alt mr-2 text-primary"></i>San José, Costa Rica</small>
                    <small class="px-2 text-light">|</small>
                    <small class="text-light"><i class="fa fa-shield-alt mr-2 text-primary"></i>Compra segura y catálogo actualizado</small>
                </div>
            </div>

            <div class="col-lg-6 text-center text-lg-right">
                @if (isLoggedIn)
                {
                    <div class="user-panel float-lg-right">
                        <a asp-controller="Profile" asp-action="Edit" class="text-decoration-none text-reset">
                            <div class="text-left mr-1">
                                <p class="user-panel__name">
                                    <i class="fa fa-user mr-1 text-primary"></i>@userName
                                </p>
                                <p class="user-panel__role">@userRole</p>
                            </div>
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0" data-clear-private-storage="true">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary logout-btn" style="color: #fff !important;">
                                <i class="fa fa-sign-out-alt mr-1"></i>Cerrar sesión
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="container-fluid bg-dark mb-30 modern-nav-shell">
        <div class="row px-xl-5">
            <div class="col-lg-2 d-none d-lg-block">
                <a class="btn d-flex align-items-center justify-content-between bg-primary w-100 header-categories-button" data-toggle="collapse" href="#navbar-vertical">
                    <h6 class="text-dark m-0"><i class="fa fa-bars mr-2"></i>Categorías</h6>
                    <i class="fa fa-angle-down text-dark"></i>
                </a>

                <nav class="collapse position-absolute navbar navbar-vertical navbar-light align-items-start p-0 bg-light header-categories-panel" id="navbar-vertical">
                    <div class="navbar-nav w-100">
                        @foreach (var categoria in categoriasLayout)
                        {
                            <a asp-controller="Home" asp-action="Shop" asp-route-categoria="@categoria" class="nav-item nav-link">@categoria</a>
                        }
                    </div>
                </nav>
            </div>

            <div class="col-lg-10">
                <nav class="navbar navbar-expand-lg bg-dark navbar-dark py-3 py-lg-0 px-0 brand-navbar-shell">
                    <a asp-controller="Home" asp-action="Index" class="brand-navbar text-decoration-none" aria-label="@SiteBrandName">
                        <span class="brand-navbar__mark" aria-hidden="true">
                            <img class="brand-navbar__icon" src="@Url.Content("~/brand/logo-icon.png")" alt="" onerror="this.style.display='none';" />
                            <span class="brand-navbar__initials">DJJ</span>
                        </span>
                        <span class="brand-navbar__copy">
                            <span class="brand-navbar__name">@SiteBrandName</span>
                            <span class="brand-navbar__subtitle">@SiteBrandSubtitle</span>
                        </span>
                    </a>

                    <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse justify-content-end" id="navbarCollapse">
                        <div class="navbar-nav ml-lg-auto py-0 main-nav-clean main-nav-2027">
                            <a asp-controller="Home" asp-action="Index" class="nav-item nav-link"><i class="fa fa-home mr-1"></i>Inicio</a>

                            @if (!isAdmin && (canViewBudgets || canViewExpenses || canCompareBudgets || canViewDeliveryBoard || canViewDocumentAlerts))
                            {
                                <div class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa fa-coins mr-1"></i>Finanzas</a>
                                    <div class="dropdown-menu border-0 rounded-0 m-0">
                                        @if (canViewBudgets) { <a asp-controller="Budgets" asp-action="Index" class="dropdown-item">Presupuestos anuales</a> }
                                        @if (canViewExpenses) { <a asp-controller="Expenses" asp-action="Index" class="dropdown-item">Gastos operativos</a> }
                                        @if (canCompareBudgets) { <a asp-controller="BudgetComparison" asp-action="Index" class="dropdown-item">Presupuesto vs. real</a> }
                                        @if (canViewDeliveryBoard) { <a asp-controller="DeliveryBoard" asp-action="Index" class="dropdown-item">Tablero de entregas</a> }
                                        @if (canViewDocumentAlerts) { <a asp-controller="Documents" asp-action="Alerts" class="dropdown-item"><i class="fa fa-bell text-warning mr-1"></i>Alertas documentales</a> }
                                    </div>
                                </div>
                            }

                            @if (!isAdmin && (canViewSuppliers || canViewPurchaseOrders || canViewPriceHistory))
                            {
                                <div class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa fa-shopping-cart mr-1"></i>Compras</a>
                                    <div class="dropdown-menu border-0 rounded-0 m-0">
                                        @if (canViewSuppliers) { <a asp-controller="Suppliers" asp-action="Index" class="dropdown-item">Proveedores</a> }
                                        @if (canViewPurchaseOrders) { <a asp-controller="PurchaseOrders" asp-action="Index" class="dropdown-item">Órdenes de compra</a> }
                                        @if (canViewPriceHistory) { <a asp-controller="PriceHistory" asp-action="Index" class="dropdown-item">Histórico de precios</a> }
                                    </div>
                                </div>
                            }

                            @if (!isAdmin && (canViewEmployees || canManageLeaveRequests || canApproveAttendance || canViewPayroll || canManagePaySlips))
                            {
                                <div class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa fa-user-tie mr-1"></i>Personal</a>
                                    <div class="dropdown-menu border-0 rounded-0 m-0">
                                        @if (canViewEmployees) { <a asp-controller="Employees" asp-action="Index" class="dropdown-item">Empleados</a> }
                                        @if (canManageLeaveRequests) { <a asp-controller="Employees" asp-action="LeaveRequests" class="dropdown-item">Solicitudes (licencias)</a> }
                                        @if (canApproveAttendance) { <a asp-controller="Attendance" asp-action="Index" class="dropdown-item">Aprobar jornadas</a> }
                                        @if (canViewPayroll) { <a asp-controller="Payroll" asp-action="Index" class="dropdown-item">Planilla</a> }
                                        @if (canManagePaySlips) { <a asp-controller="PaySlips" asp-action="Index" class="dropdown-item">Boletas de pago</a> }
                                    </div>
                                </div>
                            }

                            @if (isAdmin)
                            {
                                <div class="nav-item dropdown admin-nav-dropdown admin-accordion-dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown" data-display="static" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-th-large mr-1"></i>Administración
                                    </a>
                                    <div class="dropdown-menu admin-acc-menu border-0 m-0" aria-label="Administración">
                                        <div class="admin-acc__head">
                                            <span class="admin-acc__eyebrow">Panel</span>
                                            <span class="admin-acc__title">Administración</span>
                                            <span class="admin-acc__meta">8 áreas · 33 módulos</span>
                                        </div>
                                        <div class="admin-acc__scroll">

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-boxes"></i></span>
                                                    <span class="acc-sec__label">Inventario</span>
                                                    <i class="fa fa-chevron-down acc-sec__chev"></i>
                                                </summary>
                                                <div class="acc-sec__list">
                                                    <a asp-controller="Inventory" asp-action="Index" class="acc-item"><i class="fa fa-boxes"></i><span>Inventario</span></a>
                                                    <a asp-controller="Inventory" asp-action="Movements" class="acc-item"><i class="fa fa-exchange-alt"></i><span>Movimientos</span></a>
                                                    <a asp-controller="Inventory" asp-action="TransformStock" class="acc-item"><i class="fa fa-recycle"></i><span>Transformar producto</span></a>
                                                    <a asp-controller="Combos" asp-action="Index" class="acc-item"><i class="fa fa-box-open"></i><span>Combos</span></a>
                                                    <a asp-controller="Returns" asp-action="Index" class="acc-item"><i class="fa fa-undo"></i><span>Devoluciones</span></a>
                                                    <a asp-controller="Returns" asp-action="Quarantine" class="acc-item"><i class="fa fa-biohazard"></i><span>Cuarentena</span></a>
                                                    <a asp-controller="Assets" asp-action="Index" class="acc-item"><i class="fa fa-snowflake"></i><span>Activos</span></a>
                                                </div>
                                            </details>

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-shopping-bag"></i></span>
                                                    <span class="acc-sec__label">Ventas y Pedidos</span>
                                                    <i class="fa fa-chevron-down acc-sec__chev"></i>
                                                </summary>
                                                <div class="acc-sec__list">
                                                    <a asp-controller="OrdersAdmin" asp-action="Index" class="acc-item"><i class="fa fa-clipboard-list"></i><span>Pedidos</span></a>
                                                    <a asp-controller="Billing" asp-action="Index" class="acc-item"><i class="fa fa-file-invoice-dollar"></i><span>Facturación</span></a>
                                                    <a asp-controller="AccountsReceivableAdmin" asp-action="Index" class="acc-item"><i class="fa fa-receipt"></i><span>Cuentas por Cobrar</span></a>
                                                    <a asp-controller="Promotions" asp-action="Index" class="acc-item"><i class="fa fa-tags"></i><span>Promociones</span></a>
                                                    <a asp-controller="WarrantyRequestsAdmin" asp-action="Index" class="acc-item"><i class="fa fa-shield-alt"></i><span>Solicitudes de Garantía</span></a>
                                                </div>
                                            </details>

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-truck"></i></span>
                                                    <span class="acc-sec__label">Logística y Flota</span>
                                                    <i class="fa fa-chevron-down acc-sec__chev"></i>
                                                </summary>
                                                <div class="acc-sec__list">
                                                    <a asp-controller="RoutesAdmin" asp-action="Index" class="acc-item"><i class="fa fa-route"></i><span>Rutas y Entregas</span></a>
                                                    <a asp-controller="DeliveryBoard" asp-action="Index" class="acc-item"><i class="fa fa-th-large"></i><span>Tablero de entregas</span></a>
                                                    <a asp-controller="Vehicles" asp-action="Index" class="acc-item"><i class="fa fa-truck"></i><span>Vehículos</span></a>
                                                    <a asp-controller="Fleet" asp-action="Mileage" class="acc-item"><i class="fa fa-tachometer-alt"></i><span>Kilometraje</span></a>
                                                    <a asp-controller="Fleet" asp-action="Maintenance" class="acc-item"><i class="fa fa-wrench"></i><span>Mantenimiento</span></a>
                                                    <a asp-controller="Fleet" asp-action="Alerts" class="acc-item"><i class="fa fa-bell"></i><span>Alertas de flota</span></a>
                                                    <a asp-controller="Comodatos" asp-action="Index" class="acc-item"><i class="fa fa-handshake"></i><span>Comodatos</span></a>
                                                </div>
                                            </details>

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-coins"></i></span>
                                                    <span class="acc-sec__label">Finanzas</span>
                                                    <i class="fa fa-chevron-down acc-sec__chev"></i>
                                                </summary>
                                                <div class="acc-sec__list">
                                                    <a asp-controller="Finance" asp-action="Index" class="acc-item"><i class="fa fa-cash-register"></i><span>Liquidación de cobros</span></a>
                                                    <a asp-controller="Budgets" asp-action="Index" class="acc-item"><i class="fa fa-wallet"></i><span>Presupuestos anuales</span></a>
                                                    <a asp-controller="Expenses" asp-action="Index" class="acc-item"><i class="fa fa-receipt"></i><span>Gastos operativos</span></a>
                                                    <a asp-controller="BudgetComparison" asp-action="Index" class="acc-item"><i class="fa fa-chart-bar"></i><span>Presupuesto vs. real</span></a>
                                                    <a asp-controller="FinancialReportAdmin" asp-action="Index" class="acc-item"><i class="fa fa-chart-line"></i><span>Ingresos y Egresos</span></a>
                                                    <a asp-controller="Suppliers" asp-action="Index" class="acc-item"><i class="fa fa-address-book"></i><span>Proveedores</span></a>
                                                    <a asp-controller="PurchaseOrders" asp-action="Index" class="acc-item"><i class="fa fa-shopping-cart"></i><span>Órdenes de compra</span></a>
                                                    <a asp-controller="PriceHistory" asp-action="Index" class="acc-item"><i class="fa fa-chart-area"></i><span>Histórico de precios</span></a>
                                                </div>
                                            </details>

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-chart-line"></i></span>
                                                    <span class="acc-sec__label">Reportes y Gerencia</span>
                                                    <i class="fa fa-chevron-down acc-sec__chev"></i>
                                                </summary>
                                                <div class="acc-sec__list">
                                                    <a asp-controller="Admin" asp-action="Index" class="acc-item"><i class="fa fa-tachometer-alt"></i><span>Dashboard</span></a>
                                                    <a asp-controller="ManagementDashboard" asp-action="Index" class="acc-item"><i class="fa fa-chart-line"></i><span>Tablero gerencial</span></a>
                                                    <a asp-controller="SalesReports" asp-action="Index" class="acc-item"><i class="fa fa-file-alt"></i><span>Reporte de ventas</span></a>
                                                    <a asp-controller="SellerPerformance" asp-action="Index" class="acc-item"><i class="fa fa-user-chart"></i><span>Desempeño de vendedores</span></a>
                                                    <a asp-controller="Kpis" asp-action="Index" class="acc-item"><i class="fa fa-bullseye"></i><span>Metas de ventas</span></a>
                                                    <a asp-controller="Kpis" asp-action="Report" class="acc-item"><i class="fa fa-chart-bar"></i><span>Reporte de KPIs</span></a>
                                                    <a asp-controller="InventoryIntelligence" asp-action="Index" class="acc-item"><i class="fa fa-brain"></i><span>Inteligencia de inventario</span></a>
                                                </div>
                                            </details>

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-users"></i></span>
