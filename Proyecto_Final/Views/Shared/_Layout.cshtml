                                                    <a asp-controller="Reclamos" asp-action="Index" class="acc-item"><i class="fa fa-exclamation-circle"></i><span>Reclamos</span></a>
                                                    <a asp-controller="Consultations" asp-action="Index" class="acc-item"><i class="fa fa-comments"></i><span>Consultas</span></a>
                                                </div>
                                            </details>

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-user-tie"></i></span>
                                                    <span class="acc-sec__label">Personal</span>
                                                    <i class="fa fa-chevron-down acc-sec__chev"></i>
                                                </summary>
                                                <div class="acc-sec__list">
                                                    <a asp-controller="Employees" asp-action="Index" class="acc-item"><i class="fa fa-id-badge"></i><span>Empleados</span></a>
                                                    <a asp-controller="Employees" asp-action="LeaveRequests" class="acc-item"><i class="fa fa-calendar-check"></i><span>Solicitudes (licencias)</span></a>
                                                    <a asp-controller="Attendance" asp-action="Index" class="acc-item"><i class="fa fa-clock"></i><span>Aprobar jornadas</span></a>
                                                    <a asp-controller="Payroll" asp-action="Index" class="acc-item"><i class="fa fa-calculator"></i><span>Planilla</span></a>
                                                    <a asp-controller="PaySlips" asp-action="Index" class="acc-item"><i class="fa fa-file-invoice-dollar"></i><span>Boletas de pago</span></a>
                                                </div>
                                            </details>

                                            <details class="acc-sec">
                                                <summary class="acc-sec__head">
                                                    <span class="acc-sec__icon"><i class="fa fa-shield-alt"></i></span>
                                                    <span class="acc-sec__label">Seguridad</span>
                                                    <i class="fa fa-chevron-down acc-sec__chev"></i>
                                                </summary>
                                                <div class="acc-sec__list">
                                                    <a asp-controller="Roles" asp-action="Index" class="acc-item"><i class="fa fa-user-shield"></i><span>Roles</span></a>
                                                    <a asp-controller="Permissions" asp-action="Index" class="acc-item"><i class="fa fa-key"></i><span>Permisos</span></a>
                                                    <a asp-controller="Documents" asp-action="Index" class="acc-item"><i class="fa fa-folder-open"></i><span>Documentos digitales</span></a>
