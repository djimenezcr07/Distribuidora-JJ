    <script>
        // Acordeón del menú de Administración:
        // - mantiene abierto el dropdown mientras se interactúa con el acordeón
        // - solo una sección abierta a la vez
        // - al cerrar el menú, se colapsan todas las secciones (reabre mostrando solo las 8 áreas)
        (function () {
            var dropdown = document.querySelector('.admin-accordion-dropdown');
            if (!dropdown) return;

            var menu = dropdown.querySelector('.admin-acc-menu');
            if (!menu) return;

            var sections = menu.querySelectorAll('details.acc-sec');

            // Evita que Bootstrap cierre el dropdown al pulsar una cabecera de sección.
            // Los enlaces de módulo (navegación real) sí dejan cerrar el menú.
            menu.addEventListener('click', function (e) {
                if (e.target.closest('a.acc-item')) return;
                e.stopPropagation();
            });

            // Comportamiento de acordeón: al abrir una sección se cierran las demás.
            sections.forEach(function (sec) {
                sec.addEventListener('toggle', function () {
                    if (!sec.open) return;
                    sections.forEach(function (other) {
                        if (other !== sec) other.open = false;
                    });
                });
            });

            // Al cerrarse el dropdown, colapsa todo para reabrir en limpio.
            $(dropdown).on('hidden.bs.dropdown', function () {
                sections.forEach(function (sec) { sec.open = false; });
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    @if (puedeUsarChat)
    {
        <script asp-append-version="true" src="~/js/chat.js"></script>
    }
