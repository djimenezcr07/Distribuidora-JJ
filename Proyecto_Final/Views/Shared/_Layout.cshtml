                                                    <a asp-controller="Audit" asp-action="Index" class="acc-item"><i class="fa fa-history"></i><span>Auditoría</span></a>
                                                </div>
                                            </details>

                                        </div>
                                    </div>
                                </div>
                            }

                            <a asp-controller="Home" asp-action="Shop" class="nav-item nav-link"><i class="fa fa-store mr-1"></i>Tienda</a>
                            <a asp-controller="Cart" asp-action="Index" class="nav-item nav-link"><i class="fa fa-shopping-cart mr-1"></i>Carrito</a>

                            @if (isClient)
                            {
                                <div class="nav-item dropdown">
                                    <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                                        <i class="fa fa-user-circle mr-1"></i> Mi cuenta
                                    </a>

                                    <div class="dropdown-menu rounded-0 border-0 m-0">

                                        <a asp-controller="ClientPortal"
                                           asp-action="Index"
                                           class="dropdown-item">
                                            <i class="fa fa-box"></i> Mis pedidos
                                        </a>

                                        <a asp-controller="ClientPortal"
                                           asp-action="Warranties"
                                           class="dropdown-item">
                                            <i class="fa fa-undo"></i> Mis garantías
                                        </a>

                                        <a asp-controller="ClientPortal"
                                           asp-action="Statement"
                                           class="dropdown-item">
                                            <i class="fa fa-file-invoice"></i> Estado de cuenta
                                        </a>

                                    </div>
                                </div>
                            }

                                @{
                                    var puedeUsarChat = canUseChat;
                                }

                            @if (puedeUsarChat)
                            {
                                <div class="nav-item dropdown admin-nav-dropdown">

                                    <a href="#"
